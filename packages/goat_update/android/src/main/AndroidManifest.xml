<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lives here, not in the app manifest: android/ is regenerated by CI. -->
    <!-- Updates come from GitHub Releases over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets GOAT open the system installer for its own update. Android still asks the
         owner to allow it once ("install unknown apps") and to confirm every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Shares only files/goat_update/ (the downloaded GOAT.apk), read-only, with the
             installer it is handed to. Own subclass so it never clashes with other plugins. -->
        <provider
            android:name="dev.goat.update.UpdateFileProvider"
            android:authorities="${applicationId}.goat_update.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/goat_update_paths" />
        </provider>
    </application>
</manifest>
